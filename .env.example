# Panini Sticker Collection
# Copia este archivo a .env y usa los valores de tu entorno de pruebas.
# Vite publica las variables VITE_* en el código del navegador.

# URL del proyecto de Supabase
VITE_SUPABASE_URL=https://panini-demo.example

# Clave publicable de Supabase o clave anon heredada
VITE_SUPABASE_ANON_KEY=clave-publica-de-ejemplo

# Contacto público opcional. Incluye código de país y usa solo dígitos.
VITE_WHATSAPP_NUMBER=
